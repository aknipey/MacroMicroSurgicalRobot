t;-&amp;gt; not in ROS 2 UR driver&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="640" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="1 s12" value="&lt;b&gt;micro_module_control (C++)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;grey = clutch; Jacobian IK (Eigen)&lt;br&gt;uses ManipulatorModule + Pose libs&lt;br&gt;radian deltas added to degree cmds&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="940" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="1 s13" value="&lt;b&gt;android_pose_subscriber (C++)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sub /phantom/state&lt;br&gt;pub /visualization_marker (arrow)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="360" width="240" height="80" as="geometry"/></mxCell><mxCell id="1 s14" value="&lt;b&gt;servo_node&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;pkg moveit_servo (ur_servo.yaml)&lt;br&gt;twist -&amp;gt; IK -&amp;gt; joint positions&lt;br&gt;halts at singularities / limits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="240" height="80" as="geometry"/></mxCell><mxCell id="1 s15" value="&lt;b&gt;trajectory_recorder.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;25 Hz: /joint_states + TF base_link-&amp;gt;tool0&lt;br&gt;srv ~/start, ~/stop  | pub ~/path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="510" width="240" height="80" as="geometry"/></mxCell><mxCell id="1 s16" value="&lt;b&gt;RViz2&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ur5e_teleop.rviz: robot model,&lt;br&gt