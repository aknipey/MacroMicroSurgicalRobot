value="&lt;b&gt;Run separately&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ros2 run ls_thesis trajectory_player.py home&lt;br&gt;ros2 run ls_thesis trajectory_player.py latest --speed 0.5&lt;br&gt;ros2 run ls_thesis ur5e_keyboard_teleop.py   (needs a real terminal)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="840" y="690" width="500" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="3 UR5e control detail"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 u1" value="UR5e: how a key press / pen movement becomes robot motion" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="3 u2" value="Keyboard teleop (ur5e_keyboard_teleop.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="700" height="300" as="geometry"/></mxCell><mxCell id="3 u3" value="&lt;b&gt;Key press&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;terminal in cbreak mode,&lt;br&gt;one char at a time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="150" height="70" as="geometry"/></mxCell><mxCell id="3 u4" value="&lt;b&gt;Hold window&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;first press: held 0.6 s&lt;br&gt;(covers OS auto-repeat delay)&lt;br&gt;repeats: +0.15 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="220" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="3 u5" value="&lt;b&gt;50 Hz timer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sum held keys -&amp;gt; TwistStamped&lt;br&gt;frame base_link or tool0 (&amp;#x27;t&amp;#x27;)&lt;br&gt;5 cm/s, 0.3 rad/s (+/- scales)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="250" height="80" as="geometry"/></mxCell><mxCell id="3 u6" value="&lt;b&gt;Release&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;window expires -&amp;gt; one zero twist,&lt;br&gt;then silence. Servo stops after its&lt;br&gt;0.1 s command timeout. SPACE = stop now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="450" y="240" width="250" height="90" as="geometry"/></mxCell><mxCell id="3 u7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u3" target="3 u4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u4" target="3 u5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u5" target="3 u6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u10" value="Touch teleop (ur5e_touch_teleop.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="720" height="300" as="geometry"/></mxCell><mxCell id="3 u11" value="&lt;b&gt;WHITE pressed (rising edge)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;store pen origin p0, R0&lt;br&gt;store robot origin x0, Q0 (TF)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="110" width="210" height="80" as="geometry"/></mxCell><mxCell id="3 u12" value="&lt;b&gt;100 Hz while held&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;target = x0 + s * M (p - p0)&lt;br&gt;M = axis_map [y,-x,z], s = 1&lt;br&gt;v = clamp(4 * (target - x), 0.15 m/s)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1010" y="110" width="230" height="90" as="geometry"/></mxCell><mxCell id="3 u13" value="&lt;b&gt;Optional rotation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;pen delta R R0^-1 -&amp;gt; robot frame&lt;br&gt;w = clamp(3 * rotvec err, 0.6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1260" y="110" width="200" height="80" as="geometry"/></mxCell><mxCell id="3 u14" value="&lt;b&gt;WHITE released&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;zero twist, robot holds;&lt;br&gt;re-centre pen, press again&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1260" y="250" width="200" height="70" as="geometry"/></mxCell><mxCell id="3 u15" value="&lt;b&gt;Stale pen data &amp;gt; 0.1 s&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;stop publishing -&amp;gt; Servo halts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="780" y="250" width="210" height="60" as="geometry"/></mxCell><mxCell id="3 u16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u11" target="3 u12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u12" target="3 u13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 u12" target="3 u14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1194" y="285"/></Array></mxGeometry></mxCell><mxCell id="3 u19" value="&lt;b&gt;MoveIt Servo (servo_node)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;TwistStamped -&amp;gt; Jacobian IK -&amp;gt; joint position targets&lt;br&gt;Butterworth smoothing; slows / stops near singularities,&lt;br&gt;joint limits and self-collision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="420" width="460" height="90" as="geometry"/></mxCell><mxCell id="3 u20" value="/servo_node/delta_twist_cmds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 u5" target="3 u19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="400"/><mxPoint x="592" y="400"/></Array></mxGeometry></mxCell><mxCell id="3 u21" value="/servo_node/delta_twist_cmds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 u12" target="3 u19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="400"/><mxPoint x="868" y="400"/></Array></mxGeometry></mxCell><mxCell id="3 u22" value="&lt;b&gt;At startup each teleop node calls&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/controller_manager/switch_controller -&amp;gt; forward_position_controller&lt;br&gt;/servo_node/pause_servo (false)&lt;br&gt;/servo_node/switch_command_type (TWIST)&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="400" height="90" as="geometry"/></mxCell><mxCell id="3 u23" value="Controller hand-off (only one may own the joints)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1460" height="390" as="geometry"/></mxCell><mxCell id="3 u24" value="&lt;b&gt;TELEOP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;forward_position_controller ACTIVE&lt;br&gt;&amp;lt;- servo_node streams positions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="300" height="80" as="geometry"/></mxCell><mxCell id="3 u25" value="&lt;b&gt;trajectory_player.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;confirm [y/N] -&amp;gt; switch_controller:&lt;br&gt;activate scaled_joint_trajectory_controller,&lt;br&gt;deactivate the others&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="610" width="300" height="80" as="geometry"/></mxCell><mxCell id="3 u26" value="&lt;b&gt;REPLAY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;FollowJointTrajectory goal:&lt;br&gt;pt0 at 5 s (approach), then t/speed,&lt;br&gt;points &amp;gt;= 40 ms apart; Ctrl+C cancels&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="610" width="300" height="80" as="geometry"/></mxCell><mxCell id="3 u27" value="&lt;b&gt;Back to TELEOP&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;switch_controller -&amp;gt; forward_position_controller&lt;br&gt;(skip with --no-restore-teleop)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1120" y="610" width="330" height="80" as="geometry"/></mxCell><mxCell id="3 u28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u24" target="3 u25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u25" target="3 u26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u26" target="3 u27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 u27" target="3 u24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1285" y="730"/><mxPoint x="190" y="730"/></Array></mxGeometry></mxCell><mxCell id="3 u32" value="&lt;b&gt;trajectory_recorder.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/start: clear buffer, t0 = now&lt;br&gt;every 40 ms: 6 joint angles + tool pose (x y z qx qy qz qw)&lt;br&gt;/stop: save YAML + CSV, t re-based to 0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="420" height="90" as="geometry"/></mxCell><mxCell id="3 u33" value="&lt;b&gt;trajectory_&amp;lt;date&amp;gt;.yaml&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;joint_names, base_frame, ee_frame, duration,&lt;br&gt;samples: [{time, positions[6], ee_pose[7]}]&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="520" y="780" width="360" height="90" as="geometry"/></mxCell><mxCell id="3 u34" value="&lt;b&gt;trajectory_&amp;lt;date&amp;gt;.csv&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;time, 6 joints, x, y, z, qx, qy, qz, qw&lt;br&gt;-&amp;gt; plot in Python / Excel&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="940" y="780" width="300" height="90" as="geometry"/></mxCell><mxCell id="3 u35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="3 u32" target="3 u33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 u36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 u32" target="3 u34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="910"/><mxPoint x="1090" y="910"/></Array></mxGeometry></mxCell><mxCell id="3 u37" value="player loads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 u33" target="3 u25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="750"/><mxPoint x="550" y="750"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="4 Micro-module loop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4 m1" value="micro_module_control: one 60 Hz iteration (and where it breaks)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="4 m2" value="&lt;b&gt;Wait for data&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;motor_states + min/max angles&lt;br&gt;from serial_bridge; cmds = states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m3" value="&lt;b&gt;Forward kinematics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ManipulatorModule x2 (proximal,&lt;br&gt;distal: 3 joints each) -&amp;gt; tip pose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m2" target="4 m3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m5" value="&lt;b&gt;GREY pressed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;rising edge stores origin of&lt;br&gt;tip pose and pen pose&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m3" target="4 m5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m7" value="&lt;b&gt;Desired pose&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;pos = origin + 10 x pen delta (m)&lt;br&gt;rot = slerp(..., 0.02)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m5" target="4 m7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m9" value="&lt;b&gt;Pose error&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;6-vector, capped at norm 0.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m7" target="4 m9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m11" value="&lt;b&gt;Damped inverse Jacobian&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;4x6, damping grows near joint&lt;br&gt;limits (+/-0.05, +/-0.025 rad)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1240" y="100" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m9" target="4 m11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m13" value="&lt;b&gt;BUG: unit mismatch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;joint deltas (radians, ~0.001) are added straight&lt;br&gt;onto motor commands (servo DEGREES, ~90).&lt;br&gt;MotorAngles fields are int32 -&amp;gt; each step truncates&lt;br&gt;to the same whole degree -&amp;gt; servos never move.&lt;br&gt;GetMotorPositionsFromJointPositions() (tendon&lt;br&gt;length -&amp;gt; pulley degrees) exists but is never called.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="450" height="140" as="geometry"/></mxCell><mxCell id="4 m14" value="&lt;b&gt;Limit check + clamp&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cmd += delta if within&lt;br&gt;motor min/max, then clamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1240" y="270" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m15" value="&lt;b&gt;publish MotorAngles&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;micro_module_motor_command&lt;br&gt;(int32 degrees)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m16" value="&lt;b&gt;serial_bridge.py&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;-&amp;gt; &amp;#x27;%03d&amp;#x27; x4 + newline&lt;br&gt;&amp;lt;- 12-digit actual angles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m17" value="&lt;b&gt;Arduino firmware&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;LimitServo clamps: 89-100, 84-95,&lt;br&gt;78-100, 80-94 deg&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m18" value="&lt;b&gt;Servos -&amp;gt; pulleys&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;-&amp;gt; tendons bend the&lt;br&gt;proximal + distal segments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="280" y="270" width="210" height="80" as="geometry"/></mxCell><mxCell id="4 m19" value="joint deltas (rad)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m11" target="4 m14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;dashed=1;endArrow=none;strokeColor=#b85450;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 m13" target="4 m14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m14" target="4 m15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m15" target="4 m16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m23" value="USB serial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m16" target="4 m17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m24" value="PWM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;" edge="1" parent="1" source="4 m17" target="4 m18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 m25" value="motor_states" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="4 m16" target="4 m2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="791.5" y="230"/><mxPoint x="145" y="230"/></Array></mxGeometry></mxCell><mxCell id="4 m26" value="&lt;b&gt;Other micro-module tools&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Serial_Control/ros2_bridge/keyboard_control.py: integer degree steps&lt;br&gt;-&amp;gt; works (bypasses the Jacobian path).&lt;br&gt;Serial_Control/src/main.cpp: old ncurses serial tester (serialib)&lt;br&gt;motor_control_ros.ino / motor_control_relative.ino: older ROS 1 / relative firmware&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="560" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
