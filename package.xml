<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>macro_micro_robot</name>
  <version>0.1.0</version>
  <description>Teleoperation of a UR16e and a continuum micro-manipulator with a 3D Systems Touch stylus, through MoveIt Servo, with RCM mode, run recording and replay.</description>

  <maintainer email="z5418749@student.unsw.edu.au">Aidan Knipe</maintainer>

  <license>MIT</license>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Client libraries -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>

  <!-- Message / interface packages -->
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>omni_msgs</depend>
  <depend>motor_angles_msg</depend>

  <!-- Transforms -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Linear algebra -->
  <depend>eigen</depend>

  <!-- ur_calibration_extract (UR primary interface + calibration YAML) -->
  <depend>ur_client_library</depend>
  <depend>yaml_cpp_vendor</depend>

  <!-- Runtime -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
